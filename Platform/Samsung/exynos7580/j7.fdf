# ==============================================================================
# Samsung Galaxy J7 (2015) - Exynos 7580 Flash Description File
# ==============================================================================

[FD.EXYNOS7580_UEFI]
BaseAddress   = 0x80000000
Size          = 0x01000000
ErasePolarity = 1
BlockSize     = 0x00001000
NumBlocks     = 0x1000

# 1. Bölge Tanımlaması (Region Definition)
0x00000000|0x01000000
FV = SAMSUNG_J7_FV

# ==============================================================================
# 2. Firmware Volume (FV) Tanımlaması
# ==============================================================================
[FV.SAMSUNG_J7_FV]
BlockSize          = 0x00001000
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  # --- Modüller (Bu FV içine yerleşecek kodlar) ---

  # PEI Core: EDK2'nin temel başlatıcı kodu
  INF  MdeModulePkg/Core/Pei/PeiMain.inf

  # SİZİN MODÜLÜNÜZ: "Selamun Aleyküm" diyen modül
  INF  Platform/Samsung/exynos7580/PlatformPei/PlatformPei.inf
